# Daily.co API Key for Video Consultations
# Get your API key from: https://dashboard.daily.co/developers
VITE_DAILY_API_KEY=your_daily_api_key_here

# Groq API Configuration for Online Chatbot & Image Analysis
# Get your API key from: https://console.groq.com/keys
# This key is used for both chatbot and image scanning
VITE_GROQ_API_KEY=your_groq_api_key_here

# Vision API Configuration (Optional - uses Groq key if not provided)
# Only needed if you want to use a separate key for image analysis
VITE_VISION_API_KEY=your_vision_api_key_here
